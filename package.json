{
  "name": "@atlassian/danger-plugin-atlassian",
  "version": "1.0.0",
  "description": "DangerJS plugin with Atlassian/Bitbucket Cloud helpers and declarative rules.",
  "license": "Apache-2.0",
  
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "registry": "https://packages.atlassian.com/api/npm/npm-public/"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier . --write",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "keywords": [
    "danger",
    "danger-plugin",
    "bitbucket",
    "bitbucket-cloud",
    "atlassian",
    "pull-requests",
    "ci"
  ],
  "peerDependencies": {
    "danger": ">=11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitest/coverage-v8": "5.0.5",
    "danger": "^13.0.4",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "prettier": "^3.3.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.44.1",
    "vitest": "^5.0.5"
  }
}
